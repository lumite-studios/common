{
    "name": "lumite-studios/common",
    "description": "Commonly shared files.",
    "version": "dev-main",
    "authors": [
        {
            "name": "crotanite",
            "email": "crotanite@lumitestudios.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "laravel/framework": "^13.0",
        "lorisleiva/laravel-actions": "^2.0",
        "spatie/laravel-data": "^4.0",
        "spatie/laravel-enum": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "LumiteStudios\\Common\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LumiteStudios\\Common\\CommonServiceProvider"
            ]
        }
    },
    "scripts": {
        "pint": [
            "pint"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
